{
  "name": "dsh-task-flow",
  "version": "1.1.0",
  "description": "任务星图：樱花主题的任务流程可视化插件 — 点开按钮即见任务进行到哪一步、如何继续、有哪些分支",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wqy-cell/dsh-task-flow"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "task-flow",
    "todo"
  ],
  "license": "MIT"
}
